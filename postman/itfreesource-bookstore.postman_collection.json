                "auth",
                "users"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Admin User Management: Edit user full name, role, email, status, timezone, or currency",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/users/{id}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "users",
                ":id"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Alexander Wright Updated\",\n  \"role\": \"vip_customer\",\n  \"timezone\": \"Asia/Dubai\",\n  \"currency\": \"AED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
